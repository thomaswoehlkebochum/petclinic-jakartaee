<arquillian
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://jboss.org/schema/arquillian"
        xsi:schemaLocation="http://jboss.org/schema/arquillian https://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <!--
    <defaultProtocol type="Servlet 5.0"/>
    -->

    <engine>
        <property name="deploymentExportPath">target/</property>
    </engine>

    <container qualifier="payara-managed" default="true">
        <configuration>
            <property name="payaraHome">target/payara7</property>
            <property name="allowConnectingToRunningServer">true</property>
            <property name="adminHost">localhost</property>
            <property name="adminPort">4848</property>
            <property name="enableH2">true</property>
            <property name="outputToConsole">true</property>
            <property name="adminPassword">adminadmin</property>
            <property name="postBootCommands">
                create-jdbc-connection-pool --datasourceclassname=org.postgresql.ds.PGConnectionPoolDataSource --driver-classname=org.postgresql.Driver --log-jdbc-calls=true --pooling=true --restype javax.sql.DataSource --property url=jdbc:postgresql://localhost:5432/petclinic_jakartaee_payara --property user=petclinic_jakartaee --property password=petclinic_jakartaeepwd --property driver=petclinic.war_org.postgresql.Driver_42_7 petclinicPool
                create-jdbc-resource --connectionpoolid=petclinicPool jdbc/petclinicDS
            </property>
        </configuration>
    </container>

    <extension qualifier="webdriver">
        <property name="browser">chrome</property>
    </extension>

    <extension qualifier="drone">
        <property name="instantiationTimeoutInSeconds">180</property>
    </extension>

    <extension qualifier="screenshooter">
        <property name="takeOnEveryAction">true</property>
        <property name="takeBeforeTest">true</property>
        <property name="takeAfterTest">true</property>
        <property name="takeWhenTestFailed">true</property>
    </extension>

</arquillian>