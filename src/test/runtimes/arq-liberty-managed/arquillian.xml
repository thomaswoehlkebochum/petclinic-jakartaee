<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<arquillian xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://jboss.org/schema/arquillian"
	xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

	<container qualifier="liberty_managed" default="true">
		<configuration>
			<property name="wlpHome">C:\Users\thoma\Desktop\java\petclinic-jakartaee\target\liberty\wlp</property>
			<property name="serverName">defaultServer</property>
			<property name="httpPort">8080</property>
			<property name="javaVmArguments">
				-Dsystem.context.root=/${arquillian.war.name}
			</property>
			<property name="allowConnectingToRunningServer">true</property>
		</configuration>
	</container>

	<extension qualifier="webdriver">
		<property name="browser">chrome</property>
	</extension>

	<extension qualifier="drone">
		<property name="instantiationTimeoutInSeconds">300</property>
	</extension>

	<extension qualifier="screenshooter">
		<property name="takeOnEveryAction">true</property>
		<property name="takeBeforeTest">true</property>
		<property name="takeAfterTest">true</property>
		<property name="takeWhenTestFailed">true</property>
	</extension>

</arquillian>
